# Copy to .env.local and fill in. Both values are safe to expose in the browser:
# the database's Row Level Security rules, not this key, protect the data.
# Never put the Supabase "secret" or "service_role" key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional: a Goong or MapTiler map style for production.
NEXT_PUBLIC_MAP_STYLE_URL=
